APP_NAME=AI Website Builder
APP_ENV=development
API_PREFIX=/api/v1
# Local demo (default):
DATABASE_URL=sqlite:///./ai_builder.db
# Production / Docker:
# DATABASE_URL=postgresql+psycopg://builder:builder@localhost:5432/ai_builder
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
ARTIFACT_ROOT=./artifacts
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_PROVIDER=local
# Local template engine (default). Set AI_MOCK=false + AI_API_KEY for real AI edits.
AI_MOCK=true
WORKER_POLL_INTERVAL_SECONDS=2
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Generation v2
GENERATION_PIPELINE=legacy
GEN_V2_PLANNER=true
GEN_V2_THEME=true
GEN_V2_COMPONENTS=true
GEN_V2_CONTENT=true
GEN_V2_VALIDATOR=true
GEN_V2_IMAGES=true
GEN_V2_AI_PLANNER=false

# --- Free / cheap OpenAI-compatible options (pick one) ---
# Groq (free tier, fast): https://console.groq.com
# AI_MOCK=false
# AI_API_KEY=gsk_...
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
#
# Google Gemini (free tier): https://aistudio.google.com/apikey
# AI_MOCK=false
# AI_API_KEY=...
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-2.0-flash
#
# OpenRouter free models: https://openrouter.ai
# AI_MOCK=false
# AI_API_KEY=sk-or-...
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=openrouter/free
