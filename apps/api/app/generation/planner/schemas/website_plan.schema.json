{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-builder.local/schemas/website_plan.schema.json",
  "title": "WebsitePlan",
  "type": "object",
  "required": [
    "version",
    "niche",
    "brand_name",
    "pages",
    "product_types",
    "forbidden_products",
    "image_collections",
    "theme",
    "navbar",
    "hero",
    "footer"
  ],
  "properties": {
    "version": { "type": "string" },
    "niche": { "type": "string" },
    "brand_name": { "type": "string", "minLength": 1 },
    "tagline": { "type": "string" },
    "intent": { "type": "object" },
    "theme": {
      "type": "object",
      "required": ["token_preset"],
      "properties": {
        "token_preset": { "type": "string" },
        "style": { "type": "string" },
        "primary_color": { "type": "string" },
        "color_label": { "type": "string" }
      }
    },
    "typography": { "type": "object" },
    "navbar": {
      "type": "object",
      "required": ["variant"],
      "properties": {
        "variant": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } }
      }
    },
    "footer": {
      "type": "object",
      "required": ["variant"],
      "properties": { "variant": { "type": "string" } }
    },
    "hero": {
      "type": "object",
      "required": ["variant"],
      "properties": { "variant": { "type": "string" } }
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "path", "sections"],
        "properties": {
          "name": { "type": "string" },
          "path": { "type": "string" },
          "sections": { "type": "array" }
        }
      }
    },
    "product_types": { "type": "array", "items": { "type": "string" } },
    "forbidden_products": { "type": "array", "items": { "type": "string" } },
    "image_collections": { "type": "array", "items": { "type": "string" } },
    "animations": { "type": "array", "items": { "type": "string" } },
    "seo": { "type": "object" },
    "components": { "type": "array", "items": { "type": "string" } }
  }
}
